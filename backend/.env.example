DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/amannat?sslmode=require
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=60
SMS_GATEWAY_API_KEY=
# Voxide runs in the browser: put the vox_pub_ key in frontend/.env.local as NEXT_PUBLIC_VOXIDE_PUBLIC_KEY
VOXIDE_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UPLOAD_DIR=uploads

# development | production (production never prints login codes)
APP_ENV=development
# Telegram bot for free login codes: create one with @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# polling (default, no public URL needed) | webhook
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
